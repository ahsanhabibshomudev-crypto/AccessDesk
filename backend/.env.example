# Copy this file to backend/.env (the real .env is ignored by git, never commit it).
#
# Leave DATABASE_URL empty to use the local SQLite file (backend/accessdesk.db).
# To use Supabase, paste its connection string here. If your database password
# has special characters (@ : / # ?), URL-encode them.
DATABASE_URL=
# DATABASE_URL=postgresql://postgres.<project-ref>:<password>@<pooler-host>:6543/postgres
